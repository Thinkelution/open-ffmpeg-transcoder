# Open FFmpeg Transcoder Configuration

# Mode: "serve" (API only), "worker" (worker only), "all" (both)
MODE=all

# API server port
PORT=8090

# PostgreSQL connection
DATABASE_URL=postgres://transcoder:transcoder@localhost:5432/transcoder?sslmode=disable

# Redis connection
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# API key for authentication (leave empty to disable auth)
API_KEY=

# Temp directory for intermediate files
TEMP_DIR=/tmp/transcoder

# Max concurrent transcoding jobs
MAX_WORKERS=2

# FFmpeg binary paths
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Webhook retry attempts
WEBHOOK_RETRY=3

# Default S3 credentials (can be overridden per-job)
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
