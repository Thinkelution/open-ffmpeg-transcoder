# Open FFmpeg Transcoder Configuration

# Mode: "serve" (API only), "worker" (worker only), "all" (both)
MODE=all

# API server port
PORT=8090

# PostgreSQL connection
DATABASE_URL=postgres://transcoder:transcoder@localhost:5432/transcoder?sslmode=disable

# Redis connection
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# API key for authentication (leave empty to disable auth)
API_KEY=

# Dashboard login. If DASHBOARD_PASSWORD is empty, API_KEY is accepted as the password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Temp directory for intermediate files
TEMP_DIR=/tmp/transcoder

# Max concurrent transcoding jobs
MAX_WORKERS=2

# FFmpeg binary paths
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Webhook retry attempts
WEBHOOK_RETRY=3

# Default S3 credentials (can be overridden per-job)
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Optional Wasabi/S3 bucket scanner.
# When enabled, objects under SCANNER_INPUT_PREFIX are transcoded once to HLS
# and uploaded to SCANNER_OUTPUT_PREFIX/<source-name-and-hash>/ inside the same bucket.
SCANNER_ENABLED=false
SCANNER_INTERVAL_SECONDS=60
SCANNER_BUCKET=
SCANNER_INPUT_PREFIX=
SCANNER_OUTPUT_PREFIX=hls
# Optional object-prefix template. Example: file_base_name/hls/*
# Tokens: file_base_name, source_hash, source_dir
SCANNER_OUTPUT_TEMPLATE=
SCANNER_PRIORITY=5

# HLS scanner output settings
HLS_VIDEO_CODEC=libx264
HLS_VIDEO_BITRATE=2500k
HLS_WIDTH=1280
HLS_HEIGHT=720
HLS_FRAMERATE=30
HLS_AUDIO_CODEC=aac
HLS_AUDIO_BITRATE=128k
HLS_SEGMENT_SECONDS=6
